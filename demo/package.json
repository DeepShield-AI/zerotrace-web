{
  "name": "zerotrace-chaos-demo",
  "version": "2.0.0",
  "private": true,
  "description": "微服务资源故障注入 Demo — K8s 部署版，支持 CPU/内存/网络/磁盘故障模拟",
  "scripts": {
    "dev:gateway": "node services/gateway.service.js",
    "dev:users": "node services/users.service.js",
    "dev:products": "node services/products.service.js",
    "dev:orders": "node services/orders.service.js",
    "dev:chaos": "node services/chaos.service.js",
    "dev:all": "concurrently -k -n gateway,users,products,orders,chaos -c cyan,green,yellow,magenta,red \"npm:dev:gateway\" \"npm:dev:users\" \"npm:dev:products\" \"npm:dev:orders\" \"npm:dev:chaos\"",
    "gen": "node tools/request-generator.js",
    "gen:verbose": "VERBOSE=true node tools/request-generator.js",
    "gen:fast": "QPS=20 FAULT_INTERVAL=5 FAULT_DURATION=10 node tools/request-generator.js",
    "gen:stress": "QPS=50 FAULT_INTERVAL=8 FAULT_DURATION=15 TARGETS=users,products,orders node tools/request-generator.js"
  },
  "dependencies": {
    "express": "^4.21.0",
    "ioredis": "^5.11.1"
  },
  "devDependencies": {
    "concurrently": "^10.0.3"
  },
  "engines": {
    "node": ">=18"
  }
}
